#!/bin/sh
#
# Pre-commit hook: verify staged Swift files are formatted.
# Enable with: git config core.hooksPath .githooks   (or run: mise run setup-hooks)

# Collect staged Swift files (Added/Copied/Modified), skipping deletions.
staged_swift=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift')

[ -z "$staged_swift" ] && exit 0

# Use the mise-pinned swiftformat binary when available, else fall back to PATH.
if command -v mise >/dev/null 2>&1; then
    swiftformat_cmd="mise exec -- swiftformat"
else
    swiftformat_cmd="swiftformat"
fi

# Lint-only: fail the commit if anything is unformatted, but don't modify files.
echo "$staged_swift" | tr '\n' '\0' | xargs -0 $swiftformat_cmd --lint
status=$?

if [ "$status" -ne 0 ]; then
    echo ""
    echo "✗ SwiftFormat found unformatted code in staged files."
    echo "  Run 'mise run format' and re-stage your changes."
    exit 1
fi

exit 0
